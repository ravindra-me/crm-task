{
  "name": "backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/backend/app",
  "targets": {
    "db-up": {
      "command": "docker compose up -d --wait db",
      "options": {
        "cwd": "apps/backend"
      }
    },
    "migrate": {
      "command": "uv run alembic upgrade head",
      "options": {
        "cwd": "apps/backend"
      },
      "dependsOn": [
        "db-up"
      ]
    },
    "seed": {
      "command": "uv run python -m app.seed",
      "options": {
        "cwd": "apps/backend"
      },
      "dependsOn": [
        "migrate"
      ]
    },
    "serve": {
      "command": "uv run uvicorn app.main:app --reload --port ${BACKEND_PORT:-8000}",
      "options": {
        "cwd": "apps/backend"
      },
      "dependsOn": [
        "migrate"
      ],
      "continuous": true
    },
    "test": {
      "command": "uv run pytest -q",
      "options": {
        "cwd": "apps/backend"
      },
      "dependsOn": [
        "db-up"
      ]
    },
    "lint": {
      "command": "uv run ruff check . && uv run ruff format --check .",
      "options": {
        "cwd": "apps/backend"
      }
    },
    "typecheck": {
      "command": "uv run mypy app",
      "options": {
        "cwd": "apps/backend"
      }
    }
  }
}
